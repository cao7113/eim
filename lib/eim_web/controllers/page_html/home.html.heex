<Layouts.app flash={@flash} current_user={@current_user}>
  <section class="relative isolate overflow-hidden">
    <div class="absolute -right-32 -top-32 -z-10 size-[30rem] rounded-full bg-lime-200/50 blur-3xl">
    </div>
    <div class="grid items-center gap-14 py-12 sm:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20 lg:py-24">
      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-lime-300/70 bg-lime-50 px-3 py-1.5 text-xs font-semibold tracking-wide text-lime-900">
          <span class="size-1.5 rounded-full bg-lime-600"></span> YOUR WORDS, WORKING FOR YOU
        </p>
        <h1 class="mt-7 text-5xl font-semibold leading-[1.08] tracking-tight text-slate-950 sm:text-6xl">
          Make every word
          <span class="relative whitespace-nowrap text-lime-700">
            count.
            <span class="absolute -bottom-1 left-0 -z-10 h-3 w-full -rotate-2 rounded-full bg-lime-200/80"></span>
          </span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">
          Meet the words you don't know, save the ones you want to remember, and build an English habit that sticks.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href="/register"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-950 px-5 py-3.5 text-sm font-semibold text-white shadow-lg shadow-slate-950/10 transition hover:-translate-y-0.5 hover:bg-lime-800"
          >
            Start learning <.icon name="hero-arrow-right" class="size-4" />
          </a>
          <a
            href="#how-it-works"
            class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white/70 px-5 py-3.5 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-white"
          >
            See how it works
          </a>
        </div>
        <div class="mt-8 flex items-center gap-3 text-sm text-slate-500">
          <div class="flex -space-x-2">
            <span class="flex size-8 items-center justify-center rounded-full border-2 border-white bg-orange-100 text-xs font-semibold text-orange-800">A</span>
            <span class="flex size-8 items-center justify-center rounded-full border-2 border-white bg-sky-100 text-xs font-semibold text-sky-800">M</span>
            <span class="flex size-8 items-center justify-center rounded-full border-2 border-white bg-violet-100 text-xs font-semibold text-violet-800">J</span>
          </div>
          <span>A little progress, every day.</span>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-xl">
        <div class="absolute -left-7 top-12 size-24 rounded-full bg-orange-200/70 blur-2xl"></div>
        <div class="absolute -bottom-8 -right-5 size-32 rounded-full bg-lime-200/80 blur-2xl">
        </div>
        <div class="relative overflow-hidden rounded-[1.75rem] border border-slate-200/80 bg-white shadow-2xl shadow-slate-900/10">
          <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
            <div class="flex items-center gap-2">
              <span class="flex size-8 items-center justify-center rounded-lg bg-lime-100 text-lime-800">
                <.icon name="hero-book-open" class="size-4" />
              </span>
              <span class="text-sm font-semibold text-slate-800">Your learning space</span>
            </div>
            <span class="flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
              <span class="size-1.5 rounded-full bg-lime-500"></span> In progress
            </span>
          </div>

          <div class="p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">
              A word from your reading
            </p>
            <div class="mt-5 rounded-2xl bg-[#f7f8f3] p-5 sm:p-6">
              <p class="text-sm leading-7 text-slate-600">
                “The old bookstore had a
                <span class="rounded bg-lime-200/80 px-1 text-slate-900">serendipitous</span>
                charm, with new discoveries tucked into every corner.”
              </p>
              <div class="mt-5 flex items-center justify-between border-t border-slate-200/70 pt-4">
                <div>
                  <p class="text-2xl font-semibold tracking-tight text-slate-950">
                    serendipitous
                  </p>
                  <p class="mt-1 text-sm text-slate-500">/ˌser.ənˈdɪp.ɪ.təs/ · adjective</p>
                </div>
                <span class="flex size-10 items-center justify-center rounded-full bg-white text-lime-800 shadow-sm">
                  <.icon name="hero-bookmark-solid" class="size-5" />
                </span>
              </div>
            </div>

            <div class="mt-5 flex items-center gap-3 rounded-xl border border-lime-200/80 bg-lime-50/70 p-4">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-lime-100 text-lime-800">
                <.icon name="hero-sparkles" class="size-4" />
              </span>
              <div>
                <p class="text-sm font-semibold text-slate-800">A happy accident</p>
                <p class="mt-0.5 text-xs leading-5 text-slate-600">
                  Something good found by chance.
                </p>
              </div>
              <span class="ml-auto text-xs font-medium text-lime-800">Saved</span>
            </div>
          </div>

          <div class="flex items-center justify-between border-t border-slate-100 px-6 py-4 text-xs text-slate-500">
            <span>Small discoveries add up.</span>
            <span class="inline-flex items-center gap-1.5 font-medium text-slate-700">
              <.icon name="hero-bookmark" class="size-3.5" /> Your word list
            </span>
          </div>
        </div>
        <div class="absolute -bottom-5 -left-5 hidden items-center gap-3 rounded-2xl border border-slate-200/80 bg-white px-4 py-3 shadow-lg sm:flex">
          <span class="flex size-9 items-center justify-center rounded-xl bg-orange-100 text-orange-700">
            <.icon name="hero-cursor-arrow-rays" class="size-4" />
          </span>
          <div>
            <p class="text-xs font-semibold text-slate-800">One click to keep it</p>
            <p class="mt-0.5 text-[11px] text-slate-500">Save words as you browse</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="border-t border-slate-200/80 py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-lime-800">
        A better way to learn
      </p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
        Turn everyday reading into progress.
      </h2>
      <p class="mt-4 leading-7 text-slate-600">
        No word lists to hunt down. Just useful words, collected in the moment and ready when you are.
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200/80 bg-white p-6 transition hover:-translate-y-1 hover:shadow-lg hover:shadow-slate-900/5">
        <span class="flex size-11 items-center justify-center rounded-xl bg-sky-100 text-sky-800">
          <.icon name="hero-cursor-arrow-rays" class="size-5" />
        </span>
        <h3 class="mt-5 text-lg font-semibold text-slate-900">Read naturally</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Keep reading what you love. Select an unfamiliar word in your browser to look it up.
        </p>
      </article>
      <article class="rounded-2xl border border-slate-200/80 bg-white p-6 transition hover:-translate-y-1 hover:shadow-lg hover:shadow-slate-900/5">
        <span class="flex size-11 items-center justify-center rounded-xl bg-orange-100 text-orange-800">
          <.icon name="hero-bookmark" class="size-5" />
        </span>
        <h3 class="mt-5 text-lg font-semibold text-slate-900">Save as you go</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Useful words are saved to your personal collection, together with the context that made them stick.
        </p>
      </article>
      <article class="rounded-2xl border border-slate-200/80 bg-white p-6 transition hover:-translate-y-1 hover:shadow-lg hover:shadow-slate-900/5">
        <span class="flex size-11 items-center justify-center rounded-xl bg-violet-100 text-violet-800">
          <.icon name="hero-sparkles" class="size-5" />
        </span>
        <h3 class="mt-5 text-lg font-semibold text-slate-900">Make it yours</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Review and organize your vocabulary in one calm, focused learning space.
        </p>
      </article>
    </div>
  </section>

  <section class="mb-10 overflow-hidden rounded-[1.75rem] bg-slate-950 px-6 py-10 text-white sm:px-10 sm:py-12 lg:px-14">
    <div class="flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-center">
      <div class="max-w-xl">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-lime-300">
          A small habit goes a long way
        </p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Start with the next word.
        </h2>
        <p class="mt-3 leading-7 text-slate-300">
          Build a collection that grows with every article, story, and conversation.
        </p>
      </div>
      <a
        href="/register"
        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-lime-300 px-5 py-3.5 text-sm font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:bg-lime-200"
      >
        Create your account <.icon name="hero-arrow-right" class="size-4" />
      </a>
    </div>
  </section>
</Layouts.app>
