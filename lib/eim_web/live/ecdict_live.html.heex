<Layouts.app flash={@flash} current_user={@current_user}>
  <section class="py-5 sm:py-7">
    <div id="ecdict-workspace" phx-hook=".EcdictKeyboard" class="mx-auto max-w-6xl">
      <header class="mb-4 flex flex-wrap items-start justify-between gap-3">
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-2xl font-semibold tracking-tight text-slate-950">Dictionary</h1>
            <span class="rounded-md bg-lime-100 px-2 py-1 text-[10px] font-semibold uppercase tracking-wide text-lime-800">ECDICT</span>
          </div>
          <div
            id="ecdict-import-info"
            class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500"
          >
            <span>English</span>
            <%= if @import do %>
              <span>Last import: {@import.row_count} rows processed</span>
            <% else %>
              <span>No completed import recorded</span>
            <% end %>
          </div>
        </div>
        <button
          id="ecdict-shortcuts-open"
          type="button"
          phx-click="show-shortcuts"
          aria-haspopup="dialog"
          class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-600 transition hover:border-lime-300 hover:text-lime-800"
        >
          <kbd class="rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-mono">?</kbd>
          Shortcuts
        </button>
      </header>

      <.form
        for={@form}
        id="ecdict-search-form"
        phx-change="search"
        phx-submit="search"
        class="mx-auto flex h-8 max-w-3xl items-center gap-3 rounded-xl border border-slate-200 bg-white px-3 shadow-sm transition hover:border-slate-300 focus-within:border-lime-400 focus-within:ring-4 focus-within:ring-lime-100/70"
      >
        <div class="relative flex h-full min-w-0 flex-1 items-center [&_.fieldset]:mb-0 [&_.fieldset]:h-full [&_.fieldset]:w-full [&_label]:block [&_label]:h-full">
          <.icon
            name="hero-magnifying-glass"
            class="pointer-events-none absolute left-1 top-1/2 z-10 size-4 -translate-y-1/2 text-slate-500"
          />
          <.input
            field={@form[:q]}
            type="search"
            aria-label="Search a word or word form"
            placeholder="Try give or giving"
            maxlength="500"
            phx-debounce="300"
            class="h-full w-full border-0 bg-transparent pl-8 pr-3 text-sm leading-5 text-slate-900 outline-none placeholder:text-slate-500 placeholder:opacity-100 focus:ring-0"
          />
        </div>
        <span class="shrink-0 text-xs text-slate-500"><kbd class="font-mono">/</kbd> search</span>
      </.form>
      <div
        id="ecdict-category-filter"
        class="mx-auto mt-3 flex max-w-3xl flex-wrap items-center gap-2"
        aria-label="Filter by entry form"
      >
        <button
          :for={
            {label, value} <- [
              {"All", "all"},
              {"Words", "word"},
              {"Phrases", "phrase"},
              {"Prefixes", "prefix"},
              {"Suffixes", "suffix"},
              {"Hyphenated compounds", "compound"},
              {"Dotted abbreviations", "abbreviation"},
              {"Other", "other"}
            ]
          }
          id={"ecdict-category-#{value}"}
          type="button"
          phx-click="category"
          phx-value-category={value}
          aria-pressed={to_string(@category == value)}
          class={[
            "rounded-lg border px-3 py-1.5 text-xs font-medium transition",
            if(@category == value,
              do: "border-lime-300 bg-lime-50 text-lime-900",
              else:
                "border-slate-200 bg-white text-slate-600 hover:border-lime-300 hover:text-lime-800"
            )
          ]}
        >{label}</button>
      </div>

      <div
        :if={@error}
        id="ecdict-error"
        role="alert"
        class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900"
      >
        {@error} <a href="/dicts/ecdict" class="font-semibold underline">Start again</a>
      </div>

      <div
        :if={!@error}
        class="mt-5 grid items-start gap-4 lg:grid-cols-[minmax(18rem,0.82fr)_minmax(0,1.18fr)]"
      >
        <div id="ecdict-list-pane" class="min-w-0">
          <div class="mb-2 flex items-center justify-between px-1">
            <h2 class="text-sm font-semibold text-slate-800">
              {if @query == "", do: "Browse words", else: "Search results"}
            </h2>
            <span class="text-xs text-slate-500">A–Z · 10 per page</span>
          </div>
          <div
            id="ecdict-entries"
            phx-update="stream"
            aria-label="Dictionary entries"
            class="max-h-[min(72vh,48rem)] overflow-y-auto rounded-2xl border border-slate-200 bg-white shadow-sm"
          >
            <div
              id="ecdict-empty"
              class="hidden px-6 py-14 text-center text-sm text-slate-500 only:block"
            >
              No entries found. Try another prefix or category.
            </div>
            <.link
              :for={{id, entry} <- @streams.entries}
              id={id}
              patch={detail_path(entry.id, @query, @cursor, @category)}
              data-ecdict-entry={entry.id}
              aria-current={@entry && @entry.id == entry.id && "true"}
              class={[
                "group flex min-h-20 items-center justify-between gap-4 border-b border-slate-100 px-4 py-4 transition last:border-0 hover:bg-lime-50/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-lime-600",
                @entry && @entry.id == entry.id && "bg-lime-50 ring-1 ring-inset ring-lime-200"
              ]}
            >
              <div class="min-w-0">
                <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                  <span class="text-sm font-semibold text-slate-950 group-hover:text-lime-800">{entry.word}</span>
                  <span :if={entry.phonetic} class="text-xs text-slate-400">/{entry.phonetic}/</span>
                </div>
                <p class="mt-1 truncate text-xs text-slate-500">{summary(entry.translation)}</p>
              </div>
              <.icon
                name="hero-chevron-right"
                class="size-4 shrink-0 text-slate-300 transition group-hover:text-lime-700"
              />
            </.link>
          </div>
          <nav
            id="ecdict-pagination"
            aria-label="Dictionary pages"
            class="mt-3 flex items-center justify-between gap-3 rounded-2xl border border-slate-200/80 bg-white px-3 py-2.5 sm:px-4"
          >
            <.link
              :if={@previous}
              id="ecdict-previous"
              patch={list_path(@query, @previous, @category)}
              class="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-50"
            ><.icon name="hero-arrow-left" class="size-4" /> Previous</.link>
            <button
              :if={!@previous}
              id="ecdict-previous"
              type="button"
              disabled
              class="inline-flex items-center gap-1 rounded-lg border border-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-300"
            ><.icon name="hero-arrow-left" class="size-4" /> Previous</button>
            <.link
              :if={@next}
              id="ecdict-next"
              patch={list_path(@query, @next, @category)}
              class="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-50"
            >Next <.icon name="hero-arrow-right" class="size-4" /></.link>
            <button
              :if={!@next}
              id="ecdict-next"
              type="button"
              disabled
              class="inline-flex items-center gap-1 rounded-lg border border-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-300"
            >Next <.icon name="hero-arrow-right" class="size-4" /></button>
          </nav>
        </div>

        <div
          :if={!@entry}
          id="ecdict-detail-placeholder"
          class="hidden min-h-72 flex-col items-center justify-center self-stretch rounded-2xl border border-dashed border-slate-300 bg-white/70 px-6 text-center lg:flex"
        >
          <span class="flex size-12 items-center justify-center rounded-2xl bg-lime-100 text-lime-800"><.icon
            name="hero-book-open"
            class="size-6"
          /></span>
          <span class="mt-4 text-sm font-semibold text-slate-800">Choose a word</span>
          <span class="mt-1 text-xs text-slate-500">Press j/k or ↑/↓ to browse</span>
        </div>

        <.link
          :if={@entry}
          id="ecdict-detail-backdrop"
          patch={list_path(@query, @cursor, @category)}
          aria-label="Close dictionary details"
          class="fixed inset-0 z-30 bg-slate-950/30 backdrop-blur-[2px] lg:hidden"
        ><span class="sr-only">Close dictionary details</span></.link>
        <aside
          :if={@entry}
          id="ecdict-detail"
          class="fixed inset-x-3 bottom-3 top-14 z-40 flex min-h-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl lg:static lg:max-h-[min(80vh,54rem)] lg:min-h-72 lg:shadow-sm"
        >
          <div class="flex items-start justify-between gap-4 border-b border-slate-100 bg-slate-50/70 px-5 py-5 sm:px-7">
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-lime-700">
                ECDICT · English
              </p>
              <h2
                id="ecdict-detail-word"
                class="mt-2 break-words text-3xl font-semibold tracking-tight text-slate-950"
              >
                {@entry.word}
              </h2>
              <p :if={@entry.phonetic} class="mt-2 text-sm text-slate-500">/{@entry.phonetic}/</p>
            </div>
            <div id="ecdict-detail-actions" class="flex shrink-0 items-center gap-1 sm:gap-2">
              <%= cond do %>
                <% !@current_user -> %>
                  <a
                    id="ecdict-sign-in"
                    href={sign_in_path(@entry.id, @query, @cursor, @category)}
                    aria-label="Sign in to save"
                    title="Sign in to save"
                    class="inline-flex items-center gap-2 rounded-xl bg-slate-950 p-2.5 text-sm font-semibold text-white transition hover:bg-lime-800 sm:px-4"
                  >
                    <.icon name="hero-bookmark" class="size-4" />
                    <span class="hidden sm:inline">Sign in to save</span>
                  </a>
                <% @saved_entry_error -> %>
                  <span
                    id="ecdict-saved-error"
                    role="alert"
                    class="max-w-32 text-xs text-red-700 sm:max-w-48"
                  >
                    {@saved_entry_error}
                  </span>
                <% @saved_entry -> %>
                  <.link
                    id="ecdict-saved-link"
                    navigate={~p"/learn/vocab?#{%{entry_id: @saved_entry.id}}"}
                    aria-label="Open saved word in vocabulary"
                    title="Open saved word in vocabulary"
                    class="inline-flex items-center gap-2 rounded-xl border border-lime-300 bg-lime-50 p-2.5 text-sm font-semibold text-lime-900 transition hover:bg-lime-100 sm:px-4"
                  >
                    <.icon name="hero-bookmark-solid" class="size-4" />
                    <span class="hidden sm:inline">Open in vocabulary</span>
                    <.icon
                      name="hero-arrow-top-right-on-square"
                      class="hidden size-4 sm:inline-block"
                    />
                  </.link>
                <% true -> %>
                  <button
                    id="ecdict-save"
                    type="button"
                    phx-click="save"
                    aria-label="Save word"
                    title="Save word"
                    class="inline-flex items-center gap-2 rounded-xl bg-slate-950 p-2.5 text-sm font-semibold text-white transition hover:bg-lime-800 sm:px-4"
                  >
                    <.icon name="hero-bookmark" class="size-4" />
                    <span class="hidden sm:inline">Save word</span>
                  </button>
              <% end %>
              <.link
                id="ecdict-back"
                patch={list_path(@query, @cursor, @category)}
                aria-label="Close dictionary details"
                class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-200 hover:text-slate-900"
              >
                <.icon name="hero-x-mark" class="size-5" />
              </.link>
            </div>
          </div>
          <div class="min-h-0 overflow-y-auto px-5 py-6 sm:px-7">
            <div class="space-y-7">
              <section :if={@entry.translation} id="ecdict-translation">
                <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">
                  Chinese meanings
                </h3>
                <p class="mt-3 whitespace-pre-line text-sm leading-7 text-slate-800">
                  {String.replace(@entry.translation, "\\n", "\n")}
                </p>
              </section>
              <section :if={@entry.definition} id="ecdict-definition">
                <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">
                  English definition
                </h3>
                <p class="mt-3 whitespace-pre-line text-sm leading-7 text-slate-700">
                  {String.replace(@entry.definition, "\\n", "\n")}
                </p>
              </section>
              <p
                :if={!@entry.translation && !@entry.definition}
                id="ecdict-no-definition"
                class="text-sm text-slate-500"
              >
                No definition is available for this entry.
              </p>
              <section>
                <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">
                  Word forms
                </h3>
                <div id="ecdict-forms" phx-update="stream" class="mt-3 flex flex-wrap gap-2">
                  <p id="ecdict-no-forms" class="hidden text-sm text-slate-500 only:block">
                    No related forms are recorded.
                  </p>
                  <span
                    :for={{id, form} <- @streams.forms}
                    id={id}
                    class="rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-700"
                  >{form.form}
                  <span class="text-xs text-slate-400">· {String.replace(form.form_type, "_", " ")}</span></span>
                </div>
                <p :if={@entry.lemma} class="mt-3 text-sm text-slate-500">
                  Recorded base form:
                  <span class="font-medium text-slate-800">{@entry.lemma}</span>
                </p>
              </section>
              <div class="grid gap-5 border-t border-slate-100 pt-6 sm:grid-cols-2">
                <div :if={@entry.pos}>
                  <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">
                    Part of speech
                  </h3>
                  <p class="mt-2 text-sm text-slate-700">{@entry.pos}</p>
                </div>
                <div :if={@entry.tags != []}>
                  <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">
                    Tags
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-slate-700">
                    {Enum.join(@entry.tags, " · ")}
                  </p>
                </div>
                <div :if={@entry.frq_rank || @entry.bnc_rank}>
                  <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">
                    Frequency rank
                  </h3>
                  <p :if={@entry.frq_rank} class="mt-2 text-sm text-slate-700">
                    FRQ: {@entry.frq_rank}
                  </p>
                  <p :if={@entry.bnc_rank} class="mt-1 text-sm text-slate-700">
                    BNC: {@entry.bnc_rank}
                  </p>
                </div>
                <div>
                  <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">
                    Source
                  </h3>
                  <a
                    href="https://github.com/skywind3000/ECDICT"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-2 inline-block text-sm font-semibold text-lime-800 underline"
                  >ECDICT</a>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </div>

      <div
        :if={@shortcuts_open}
        id="ecdict-shortcuts-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="ecdict-shortcuts-title"
        class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/35 p-4 backdrop-blur-[2px]"
      >
        <button
          id="ecdict-shortcuts-backdrop"
          type="button"
          phx-click="hide-shortcuts"
          aria-label="Close keyboard shortcuts"
          class="absolute inset-0 cursor-default"
          tabindex="-1"
        ></button>
        <div class="relative max-h-full w-full max-w-md overflow-y-auto rounded-2xl border border-slate-200 bg-white p-5 shadow-2xl">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 id="ecdict-shortcuts-title" class="text-lg font-semibold text-slate-900">
                Keyboard shortcuts
              </h2>
              <p class="mt-1 text-sm text-slate-500">Navigate this page with your keyboard.</p>
            </div>
            <button
              id="ecdict-shortcuts-close"
              type="button"
              phx-click="hide-shortcuts"
              aria-label="Close keyboard shortcuts"
              class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
            ><.icon name="hero-x-mark" class="size-5" /></button>
          </div>
          <dl class="mt-5 divide-y divide-slate-100">
            <div
              :for={
                {label, key} <- [
                  {"Select next word", "j / ↓"},
                  {"Select previous word", "k / ↑"},
                  {"Next page", "→"},
                  {"Previous page", "←"},
                  {"Select first word", "f"},
                  {"Select last word", "l"},
                  {"Focus search", "/"},
                  {"Exit field or close panel", "Esc"},
                  {"Show this guide", "?"}
                ]
              }
              class="flex items-center justify-between gap-4 py-3"
            >
              <dt class="text-sm text-slate-700">{label}</dt>
              <dd>
                <kbd class="rounded-md border border-slate-200 bg-slate-50 px-2 py-1 font-mono text-xs">{key}</kbd>
              </dd>
            </div>
          </dl>
          <p class="mt-3 text-xs leading-5 text-slate-400">
            Shortcuts are paused while typing in a field.
          </p>
        </div>
      </div>
      <script :type={Phoenix.LiveView.ColocatedHook} name=".EcdictKeyboard">
        export default {
          mounted() {
            this.onKeydown = event => {
              const target = event.target
              const editable = target instanceof HTMLElement &&
                (target.matches("input, textarea, select") || target.isContentEditable)
              const dialog = this.el.querySelector("#ecdict-shortcuts-dialog")
              if (event.key === "Escape" && dialog) {
                event.preventDefault()
                this.pushEvent("hide-shortcuts", {})
                return
              }
              if (dialog) return
              if (event.key === "Escape" && editable) {
                event.preventDefault()
                target.blur()
                return
              }
              if (editable || event.metaKey || event.ctrlKey || event.altKey) return
              if (event.key === "/") {
                event.preventDefault()
                const search = this.el.querySelector("#search_q")
                search?.focus()
                return
              }
              if (event.key === "?") {
                event.preventDefault()
                this.pushEvent("show-shortcuts", {})
                return
              }
              if (event.key === "Escape") {
                const close = this.el.querySelector("#ecdict-back")
                if (close) { event.preventDefault(); close.click() }
                return
              }
              if (["ArrowLeft", "ArrowRight"].includes(event.key)) {
                const page = this.el.querySelector(event.key === "ArrowLeft" ? "#ecdict-previous" : "#ecdict-next")
                if (page instanceof HTMLAnchorElement) {
                  event.preventDefault()
                  page.click()
                }
                return
              }
              if (!["j", "k", "f", "l", "ArrowUp", "ArrowDown"].includes(event.key)) return
              const rows = [...this.el.querySelectorAll("#ecdict-entries [data-ecdict-entry]")]
              if (rows.length === 0) return
              event.preventDefault()
              const focused = rows.indexOf(document.activeElement)
              const selected = rows.findIndex(row => row.getAttribute("aria-current") === "true")
              const current = focused >= 0 ? focused : selected
              const next = event.key === "f" ? 0
                : event.key === "l" ? rows.length - 1
                : ["j", "ArrowDown"].includes(event.key) ? Math.min(current + 1, rows.length - 1)
                : Math.max(current < 0 ? 0 : current - 1, 0)
              rows[next].focus()
              rows[next].click()
            }
            document.addEventListener("keydown", this.onKeydown)
          },
          destroyed() {
            document.removeEventListener("keydown", this.onKeydown)
          }
        }
      </script>
    </div>
  </section>
</Layouts.app>
